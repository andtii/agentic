{
  "name": "@agentic/daemon",
  "version": "0.0.0",
  "private": true,
  "description": "agentic-daemon — the machine daemon: pairs a machine to a workspace, reports environments, relays runtime sessions and tool calls.",
  "type": "module",
  "bin": {
    "agentic-daemon": "./bin/agentic-daemon.mjs"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "package": "node scripts/package.mjs",
    "start": "node bin/agentic-daemon.mjs"
  },
  "dependencies": {
    "@agentic/core": "workspace:*",
    "@agentic/daemon-protocol": "workspace:*",
    "@agentic/mcp": "workspace:*",
    "@agentic/runtimes": "workspace:*",
    "@sigx/ai": "catalog:",
    "@sigx/ai-agent": "catalog:",
    "@sigx/ai-agent-node": "catalog:",
    "@sigx/ai-agent-claude-code": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "@github/copilot-sdk": "^1.0.14",
    "@openai/codex": "^0.155.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@sigx/vite": "catalog:",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "@sigx/reactivity": "catalog:",
    "@sigx/runtime-core": "catalog:",
    "@types/ws": "^8.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
