exports[`a snapshot per UIToolState > renders the approved card 1`] = `
"<div data-scope="ai-tool-call" data-part="root" data-state="running"><div data-scope="ai-tool-call" data-part="header"><span data-scope="ai-tool-call" data-part="icon"><svg data-icon="file" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v4h4"></path><!----></svg><!----></span><code data-scope="ai-tool-call" data-part="name">ToolSearch</code><span data-scope="ai-tool-call" data-part="signature" title="query: select:Read">query: select:Read</span><!----><!----><span data-scope="ai-tool-call" data-part="status" title="running"><span data-scope="ag-pill" data-part="root" data-tone="working" data-status="running"><span data-scope="ag-pill" data-part="dot" aria-hidden="true"></span><span data-scope="ag-pill" data-part="label">RUNNING</span></span><!----></span></div><div data-scope="ai-tool-call" data-part="input"><details data-scope="collapsible" data-part="root" data-state="closed"><summary data-scope="collapsible" data-part="trigger" data-state="closed" aria-expanded="false" aria-controls="…">input</summary><!----><div id="…" data-scope="collapsible" data-part="panel" data-state="closed"><pre>{
  "query": "select:Read"
}</pre></div><!----></details><!----><!----></div><!----><!----><!----><!----><!----><!----></div><!---->"
`;

