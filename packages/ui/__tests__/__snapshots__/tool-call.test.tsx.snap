// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a snapshot per UIToolState > renders the approved card 1`] = `
"<div data-scope="ai-tool-call" data-part="root" data-state="active"><div data-scope="ai-tool-call" data-part="header"><span data-scope="ai-tool-call" data-part="icon"><svg data-icon="file" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v4h4"></path><!----></svg><!----></span><code data-scope="ai-tool-call" data-part="name">ToolSearch</code><span data-scope="ai-tool-call" data-part="signature" title="query: select:Read">query: select:Read</span><!----><span data-scope="ai-tool-call" data-part="status" title="running"><span data-scope="ag-pill" data-part="root" data-tone="working" data-status="running"><span data-scope="ag-pill" data-part="dot" aria-hidden="true"></span><span data-scope="ag-pill" data-part="label">RUNNING</span></span><!----></span></div><details data-scope="ai-tool-call" data-part="input" data-state="closed"><summary>input</summary><pre>{
  "query": "select:Read"
}</pre></details><!----><!----><!----><!----><!----></div><!---->"
`;

exports[`a snapshot per UIToolState > renders the awaiting card 1`] = `
"<div data-scope="ai-tool-call" data-part="root" data-state="loading"><div data-scope="ai-tool-call" data-part="header"><span data-scope="ai-tool-call" data-part="icon"><svg data-icon="file" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v4h4"></path><!----></svg><!----></span><code data-scope="ai-tool-call" data-part="name">ToolSearch</code><span data-scope="ai-tool-call" data-part="signature" title="query: select:Read">query: select:Read</span><span data-scope="ai-tool-call" data-part="meta">awaiting approval</span><span data-scope="ai-tool-call" data-part="status" title="awaiting approval"><span data-scope="ag-pill" data-part="root" data-tone="muted" data-mod-hollow="" data-status="pending"><span data-scope="ag-pill" data-part="dot" aria-hidden="true"></span><span data-scope="ag-pill" data-part="label">PENDING</span></span><!----></span></div><details data-scope="ai-tool-call" data-part="input" data-state="closed"><summary>input</summary><pre>{
  "query": "select:Read"
}</pre></details><!----><!----><!----><div data-scope="ai-approval" data-part="root" role="group" aria-label="Approval needed: ToolSearch query: select:Read" aria-live="assertive"><div data-scope="ai-approval" data-part="header"><svg data-icon="shield" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><path d="M12 3 4 6v6c0 4.5 3.2 8 8 9 4.8-1 8-4.5 8-9V6z"></path></svg><!----><span data-scope="ai-approval" data-part="title">Approval needed</span><!----></div><div data-scope="ai-approval" data-part="request"><code>ToolSearch</code><span>query: select:Read</span></div><p data-scope="ai-approval" data-part="description">Reads the tool list.</p><!----><div data-scope="ai-approval" data-part="actions"><button data-scope="button" data-part="root" data-intent="wait" data-color="warning" data-variant="solid" type="button"><svg data-icon="check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><path d="m5 12 5 5 9-10"></path></svg><!----><span>Allow once</span></button><!----><button data-scope="button" data-part="root" data-intent="default" data-color="neutral" data-variant="solid" type="button"><!----><span>Allow for this session</span></button><!----><button data-scope="button" data-part="root" data-intent="danger" data-color="error" data-variant="outline" type="button"><svg data-icon="close" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><path d="M6 6l12 12M18 6 6 18"></path></svg><!----><span>Deny</span></button><!----></div></div><!----><!----></div><!---->"
`;

exports[`a snapshot per UIToolState > renders the denied card 1`] = `
"<div data-scope="ai-tool-call" data-part="root" data-state="closed"><div data-scope="ai-tool-call" data-part="header"><span data-scope="ai-tool-call" data-part="icon"><svg data-icon="file" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v4h4"></path><!----></svg><!----></span><code data-scope="ai-tool-call" data-part="name">ToolSearch</code><span data-scope="ai-tool-call" data-part="signature" title="query: select:Read">query: select:Read</span><!----><span data-scope="ai-tool-call" data-part="status" title="denied"><span data-scope="ag-pill" data-part="root" data-tone="failed" data-mod-hollow="" data-status="denied"><span data-scope="ag-pill" data-part="dot" aria-hidden="true"></span><span data-scope="ag-pill" data-part="label">DENIED</span></span><!----></span></div><details data-scope="ai-tool-call" data-part="input" data-state="closed"><summary>input</summary><pre>{
  "query": "select:Read"
