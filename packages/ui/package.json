{
  "name": "@agentic/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-based UI: the ai-* chat fragment (thread, message, composer, tool call, reasoning, approval), layout shell and streaming markdown.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "production": "./dist/index.prod.js",
      "import": "./dist/index.js"
    },
    "./layout.css": "./src/layout/layout.css",
    "./shell.css": "./src/shell/shell.css",
    "./fragment": {
      "types": "./dist/fragment/index.d.ts",
      "development": "./dist/fragment.js",
      "production": "./dist/fragment.prod.js",
      "import": "./dist/fragment.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --mode prod-dist && tsc -p tsconfig.build.json && node scripts/emit-fragment.mjs"
  },
  "dependencies": {
    "@agentic/core": "workspace:*",
    "@sigx/zero": "catalog:",
    "@sigx/markdown": "catalog:",
    "@sigx/ai-agent": "catalog:",
    "@sigx/ai": "catalog:"
  },
  "devDependencies": {
    "@sigx/vite": "catalog:",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "sigx": "catalog:",
    "@sigx/reactivity": "catalog:",
    "@sigx/runtime-core": "catalog:",
    "@sigx/runtime-dom": "catalog:",
    "@sigx/zero-daisyui": "catalog:",
    "@sigx/zero-kit": "catalog:",
    "shiki": "^4.4.3"
  },
  "sigx-zero": {
    "fragment": "./dist/fragment.js",
    "requires": ">=0.2.0-beta.1"
  }
}
