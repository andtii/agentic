{
  "name": "@agentic/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-based UI: the agentic design system (control-room theme on zero-daisyui), the ai-* chat fragment (thread, message, composer, tool call, reasoning, approval), forms, layout shell and streaming markdown.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "production": "./dist/index.prod.js",
      "import": "./dist/index.js"
    },
    "./shell.css": "./src/shell/shell.css",
    "./fragment": {
      "types": "./dist/fragment/index.d.ts",
      "development": "./dist/fragment.js",
      "production": "./dist/fragment.prod.js",
      "import": "./dist/fragment.js"
    },
    "./design-system": {
      "types": "./dist/design-system/index.d.ts",
      "development": "./dist/design-system.js",
      "production": "./dist/design-system.prod.js",
      "import": "./dist/design-system.js"
    },
    "./css": {
      "types": "./css.d.ts",
      "default": "./dist/ds/css/index.css"
    },
    "./css/tokens": "./dist/ds/css/tokens.css",
    "./css/breakpoints": "./dist/ds/css/breakpoints.css",
    "./register": {
      "types": "./dist/ds/register.d.ts",
      "import": "./dist/ds/register.js"
    },
    "./manifest.json": "./dist/ds/manifest.json",
    "./fragment.json": "./dist/fragment.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --mode prod-dist && tsc -p tsconfig.build.json && sigx zero:fragment --strict && sigx zero:build ./dist/design-system.js --extra-manifest ./dist/fragment.js --out dist/ds"
  },
  "dependencies": {
    "@agentic/core": "workspace:*",
    "@sigx/zero": "catalog:",
    "@sigx/richtext": "catalog:",
    "@sigx/richtext-markdown": "catalog:",
    "@sigx/richtext-shiki": "catalog:",
    "@sigx/ai-agent": "catalog:",
    "@sigx/ai": "catalog:",
    "@sigx/zero-daisyui": "catalog:",
    "@sigx/monaco-editor": "catalog:",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@sigx/cli": "^0.12.0",
    "@sigx/vite": "catalog:",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "sigx": "catalog:",
    "@sigx/reactivity": "catalog:",
    "@sigx/runtime-core": "catalog:",
    "@sigx/runtime-dom": "catalog:",
    "@sigx/server-renderer": "catalog:",
    "@sigx/zero-kit": "catalog:"
  },
  "sigx-zero": {
    "fragment": "./dist/fragment.js",
    "requires": ">=0.5.0"
  }
}
