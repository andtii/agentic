{
  "name": "@agentic/memory",
  "version": "0.0.0",
  "private": true,
  "description": "Default MemoryPlugin: actor-backed store with provenance, scopes, keyword + recency retrieval, export/import.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "production": "./dist/index.prod.js",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "development": "./dist/testing.js",
      "production": "./dist/testing.prod.js",
      "import": "./dist/testing.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode prod-dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@agentic/core": "workspace:*",
    "@sigx/actors": "catalog:"
  },
  "devDependencies": {
    "@sigx/vite": "catalog:",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "@sigx/reactivity": "catalog:",
    "@sigx/runtime-core": "catalog:"
  }
}
