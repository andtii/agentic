{
  "name": "@agentic/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP client (consume servers as platform tools) and the platform MCP server (orchestration surface for external clients).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "production": "./dist/index.prod.js",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode prod-dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@agentic/core": "workspace:*",
    "@sigx/ai": "catalog:",
    "@sigx/ai-agent": "catalog:",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sigx/vite": "catalog:",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "@sigx/reactivity": "catalog:",
    "@sigx/runtime-core": "catalog:",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
