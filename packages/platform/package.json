{
  "name": "@agentic/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Actor definitions on @sigx/actors: Workspace, Agent, Chat, Task, Session, Machine, Schedule, Memory, Inbox, Ledger, Registry, Audit; auth helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "production": "./dist/index.prod.js",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode prod-dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@agentic/core": "workspace:*",
    "@agentic/daemon-protocol": "workspace:*",
    "@agentic/memory": "workspace:*",
    "@sigx/actors": "catalog:",
    "@sigx/ai-agent": "catalog:"
  },
  "devDependencies": {
    "@sigx/vite": "catalog:",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "@sigx/reactivity": "catalog:",
    "@sigx/runtime-core": "catalog:",
    "@sigx/serialize": "catalog:",
    "@sigx/server": "catalog:",
    "@sigx/actors-cloudflare": "catalog:"
  }
}
