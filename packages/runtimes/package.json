{
  "name": "@agentic/runtimes",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime adapters: platform-managed Anthropic agent (modelAgent), Claude Code driver, and the platform tools (memory, delegate, chat, task).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "production": "./dist/index.prod.js",
      "import": "./dist/index.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code/index.d.ts",
      "development": "./dist/claude-code.js",
      "production": "./dist/claude-code.prod.js",
      "import": "./dist/claude-code.js"
    },
    "./copilot-cli": {
      "types": "./dist/copilot-cli/index.d.ts",
      "development": "./dist/copilot-cli.js",
      "production": "./dist/copilot-cli.prod.js",
      "import": "./dist/copilot-cli.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode prod-dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@agentic/core": "workspace:*",
    "@sigx/ai": "catalog:",
    "@sigx/ai-agent": "catalog:",
    "@sigx/ai-anthropic": "catalog:",
    "@sigx/ai-agent-claude-code": "catalog:",
    "@sigx/ai-agent-node": "catalog:",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sigx/vite": "catalog:",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "@sigx/reactivity": "catalog:",
    "@sigx/runtime-core": "catalog:",
    "@anthropic-ai/sdk": "^0.126.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "@github/copilot-sdk": "^1.0.14"
  }
}
