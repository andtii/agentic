{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@sigx/runtime-core",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@agentic/core": [
        "./packages/core/src/index.ts"
      ],
      "@agentic/daemon-protocol": [
        "./packages/daemon-protocol/src/index.ts"
      ],
      "@agentic/daemon-protocol/testing": [
        "./packages/daemon-protocol/src/testing/index.ts"
      ],
      "@agentic/memory": [
        "./packages/memory/src/index.ts"
      ],
      "@agentic/memory/testing": [
        "./packages/memory/src/testing/index.ts"
      ],
      "@agentic/learning": [
        "./packages/learning/src/index.ts"
      ],
      "@agentic/runtimes/claude-code": [
        "./packages/runtimes/src/claude-code/index.ts"
      ],
      "@agentic/runtimes": [
        "./packages/runtimes/src/index.ts"
      ],
      "@agentic/platform": [
        "./packages/platform/src/index.ts"
      ],
      "@agentic/mcp": [
        "./packages/mcp/src/index.ts"
      ],
      "@agentic/a2a": [
        "./packages/a2a/src/index.ts"
      ],
      "@agentic/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@agentic/ui/design-system": [
        "./packages/ui/src/design-system/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/__tests__/**/*.ts",
    "packages/*/__tests__/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/__tests__/**/*.ts",
    "apps/*/__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist",
    "apps/web/__tests__/workers/**"
  ]
}
